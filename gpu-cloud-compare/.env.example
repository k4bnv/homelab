# Copy this file to .env and fill in your real affiliate/referral links.
#
# Any variable left unset (or empty) falls back to the placeholder
# "?ref=AFFILIATE_ID" URL already committed in src/data/providers.json —
# nothing breaks if you only fill in some of these.
#
# Read by src/lib/data.ts at build time (astro dev / astro build), so
# these get baked into the generated static HTML — there is no runtime
# lookup in the browser. Convention: AFFILIATE_URL_<SLUG>, provider slug
# uppercased with hyphens as underscores (see src/data/providers.json's
# "slug" field for each provider).

AFFILIATE_URL_RUNPOD=https://runpod.io/?ref=YOUR_ID
AFFILIATE_URL_VAST_AI=https://vast.ai/?ref=YOUR_ID
AFFILIATE_URL_TENSORDOCK=https://tensordock.com/?ref=YOUR_ID
AFFILIATE_URL_LAMBDA_LABS=https://lambdalabs.com/?ref=YOUR_ID
AFFILIATE_URL_COREWEAVE=https://coreweave.com/?ref=YOUR_ID
