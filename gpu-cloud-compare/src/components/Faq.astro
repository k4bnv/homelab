---
import JsonLd from "@/components/JsonLd.astro";
import { faqSchema } from "@/lib/schema";
import type { FaqItem } from "@/types";

interface Props {
  faqs: FaqItem[];
  title?: string;
  /** Set false when a parent component (e.g. GpuSeoSchema) already emits this FAQPage. */
  emitSchema?: boolean;
}

const { faqs, title = "Frequently Asked Questions", emitSchema = true } = Astro.props;
const schema = emitSchema ? faqSchema(faqs) : null;
---

<JsonLd schema={schema} />
<section aria-labelledby="faq-heading" class="mt-12">
  <h2 id="faq-heading" class="mb-4 text-xl font-bold text-white">{title}</h2>
  <div class="divide-y divide-surface-700 rounded-xl border border-surface-700 bg-surface-900/40">
    {faqs.map((faq, i) => (
      <details class="group px-5 py-4 open:pb-4" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-slate-200 marker:content-none">
          {faq.question}
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="shrink-0 text-neon-green transition-transform group-open:rotate-45"
            aria-hidden="true"
          >
            <path d="M12 5v14M5 12h14" />
          </svg>
        </summary>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">{faq.answer}</p>
      </details>
    ))}
  </div>
</section>
