---
/**
 * Drops a JSON-LD <script> tag. Pass one schema object or an array of them
 * (Astro pages often need Product + BreadcrumbList + FAQPage on one page).
 */
interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[] | null;
}

const { schema } = Astro.props;
const items = Array.isArray(schema) ? schema : schema ? [schema] : [];
---

{items.map((item) => <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />)}
