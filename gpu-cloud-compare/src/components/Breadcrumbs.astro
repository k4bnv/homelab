---
// Plain inline SVG (no React island) — a chevron doesn't need client JS,
// and every extra hydrated island costs bytes on every page load.
import JsonLd from "@/components/JsonLd.astro";
import { breadcrumbSchema, type BreadcrumbCrumb } from "@/lib/schema";

interface Props {
  crumbs: BreadcrumbCrumb[];
  /** Set false when a parent component (e.g. GpuSeoSchema) already emits this BreadcrumbList. */
  emitSchema?: boolean;
}

const { crumbs, emitSchema = true } = Astro.props;
const schema = emitSchema ? breadcrumbSchema(crumbs) : null;
---

<JsonLd schema={schema} />
<nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-1.5 text-sm text-slate-500">
  {crumbs.map((crumb, i) => (
    <>
      {i > 0 && (
        <svg
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="shrink-0 text-slate-700"
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6" />
        </svg>
      )}
      {i === crumbs.length - 1 ? (
        <span class="truncate text-slate-300" aria-current="page">{crumb.name}</span>
      ) : (
        <a href={crumb.path} class="shrink-0 hover:text-neon-green">{crumb.name}</a>
      )}
    </>
  ))}
</nav>
