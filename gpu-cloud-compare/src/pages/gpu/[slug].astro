---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Faq from "@/components/Faq.astro";
import PriceBadge from "@/components/ui/PriceBadge.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import { getAllGpus, getGpuById, getComputedOffersForGpu, formatUsd } from "@/lib/data";
import { buildMeta } from "@/lib/seo";
import { gpuProductSchema } from "@/lib/schema";
import { buildGpuFaq } from "@/lib/faq";

export function getStaticPaths() {
  return getAllGpus().map((gpu) => ({
    params: { slug: gpu.id },
  }));
}

const { slug } = Astro.params;
const gpu = getGpuById(slug as string);

if (!gpu) {
  return Astro.redirect("/404");
}

const offers = getComputedOffersForGpu(gpu.id);
const faqs = buildGpuFaq(gpu, offers);
const productSchema = gpuProductSchema(gpu, offers);
const cheapest = offers[0];

const meta = buildMeta({
  title: `${gpu.name} Cloud Rental — Compare Prices Across ${offers.length} Providers`,
  description: `Compare ${gpu.name} (${gpu.vram_gb}GB ${gpu.vram_type}) rental prices across ${offers
    .map((o) => o.name)
    .join(", ")}. On-demand from ${formatUsd(cheapest?.price_on_demand ?? 0)}/hr, plus spot pricing and hidden fees.`,
  canonicalPath: `/gpu/${gpu.id}/`,
  type: "article",
});
---

<BaseLayout meta={meta} schema={productSchema}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumbs
      crumbs={[
        { name: "Home", path: "/" },
        { name: gpu.name, path: `/gpu/${gpu.id}/` },
      ]}
    />

    <div class="flex flex-wrap items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          {gpu.name} Cloud Rental Prices
        </h1>
        <p class="mt-3 max-w-2xl text-slate-400">{gpu.description}</p>
      </div>

      {cheapest && (
        <div class="card min-w-[220px] p-5 text-right">
          <p class="text-xs uppercase tracking-wide text-slate-500">From</p>
          <p class="font-mono text-3xl font-extrabold text-neon-green">
            {formatUsd(cheapest.price_on_demand)}<span class="text-base text-slate-500">/hr</span>
          </p>
          <p class="mt-1 text-xs text-slate-500">via {cheapest.name}</p>
          <CtaButton href={cheapest.affiliate_url} class="mt-3 w-full">
            Rent for {formatUsd(cheapest.price_on_demand)}/hr
          </CtaButton>
        </div>
      )}
    </div>

    {/* Spec grid */}
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {[
        ["VRAM", `${gpu.vram_gb} GB ${gpu.vram_type}`],
        ["Architecture", gpu.architecture],
        ["CUDA Cores", gpu.cuda_cores?.toLocaleString() ?? "—"],
        ["FP16 TFLOPS", gpu.fp16_tflops ? `${gpu.fp16_tflops}` : "—"],
        ["Memory Bandwidth", gpu.memory_bandwidth_gbps ? `${gpu.memory_bandwidth_gbps} GB/s` : "—"],
        ["NVLink", gpu.nvlink ? "Yes" : "No"],
        ["Release Year", `${gpu.release_year}`],
        ["Providers Tracked", `${offers.length}`],
      ].map(([label, value]) => (
        <div class="card p-3">
          <p class="text-[11px] uppercase tracking-wide text-slate-500">{label}</p>
          <p class="mt-1 font-mono text-sm font-semibold text-slate-200">{value}</p>
        </div>
      ))}
    </div>

    {/* Highlights */}
    <ul class="mt-6 grid gap-2 sm:grid-cols-3">
      {gpu.highlights.map((h) => (
        <li class="card flex items-start gap-2 p-3 text-sm text-slate-300">
          <span class="mt-0.5 text-neon-green">▸</span>
          {h}
        </li>
      ))}
    </ul>

    {/* Provider comparison table */}
    <section class="mt-12">
      <h2 class="mb-4 text-2xl font-bold text-white">
        {gpu.name} Price Comparison — {offers.length} Providers
      </h2>
      <div class="card overflow-x-auto">
        <table class="w-full min-w-[680px] text-left text-sm">
          <thead>
            <tr class="border-b border-surface-700 text-xs uppercase tracking-wide text-slate-500">
              <th class="px-4 py-3 font-medium">Provider</th>
              <th class="px-4 py-3 font-medium">On-Demand</th>
              <th class="px-4 py-3 font-medium">Spot</th>
              <th class="px-4 py-3 font-medium">Storage</th>
              <th class="px-4 py-3 font-medium">Egress</th>
              <th class="px-4 py-3 font-medium">Rating</th>
              <th class="px-4 py-3 font-medium text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-800">
            {offers.map((offer) => (
              <tr class="hover:bg-surface-800/50">
                <td class="px-4 py-3">
                  <span class="font-semibold text-slate-100">
                    {offer.logo_emoji} {offer.name}
                  </span>
                  <div class="mt-0.5 text-xs text-slate-500">{offer.payment_model}</div>
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <span class="font-mono font-semibold text-slate-100">
                      {formatUsd(offer.price_on_demand)}
                    </span>
                    {offer.is_best_price && <PriceBadge variant="best-price" />}
                  </div>
                </td>
                <td class="px-4 py-3">
                  {offer.price_spot !== null ? (
                    <span class="font-mono text-neon-blue">{formatUsd(offer.price_spot)}</span>
                  ) : (
                    <span class="text-xs text-slate-600">Not offered</span>
                  )}
                </td>
                <td class="px-4 py-3 text-xs text-slate-400">
                  {formatUsd(offer.storage_cost_per_gb, 2)}/GB/mo
                </td>
                <td class="px-4 py-3 text-xs text-slate-400">
                  {offer.egress_cost_per_gb === 0 ? "Free" : `${formatUsd(offer.egress_cost_per_gb, 2)}/GB`}
                </td>
                <td class="px-4 py-3 text-xs text-slate-300">★ {offer.rating.toFixed(1)}</td>
                <td class="px-4 py-3 text-right">
                  <CtaButton href={offer.affiliate_url} variant={offer.is_best_price ? "primary" : "secondary"}>
                    Rent Now
                  </CtaButton>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <Faq faqs={faqs} title={`${gpu.name} FAQ`} />
  </div>
</BaseLayout>
