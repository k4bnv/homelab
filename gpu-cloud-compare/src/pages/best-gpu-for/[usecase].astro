---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Faq from "@/components/Faq.astro";
import PriceBadge from "@/components/ui/PriceBadge.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import { useCases, getUseCaseBySlug, getGpusForUseCase, getComputedOffersForGpu, formatUsd } from "@/lib/data";
import { buildMeta } from "@/lib/seo";
import type { FaqItem } from "@/types";

export function getStaticPaths() {
  return useCases.map((uc) => ({ params: { usecase: uc.slug } }));
}

const { usecase } = Astro.params;
const useCase = getUseCaseBySlug(usecase as string);

if (!useCase) {
  return Astro.redirect("/404");
}

const recommendedGpus = getGpusForUseCase(useCase);
const gpuOffers = recommendedGpus.map((gpu) => ({
  gpu,
  offers: getComputedOffersForGpu(gpu.id),
}));
const top = gpuOffers[0];

const meta = buildMeta({
  title: useCase.title,
  description: `${useCase.description} Compare live prices for ${recommendedGpus
    .map((g) => g.name)
    .join(", ")} across every major GPU cloud provider.`,
  canonicalPath: `/best-gpu-for/${useCase.slug}/`,
  type: "article",
});

const faqs: FaqItem[] = [
  {
    question: `What is the best GPU for ${useCase.short_title}?`,
    answer: top
      ? `The ${top.gpu.name} is our top pick for ${useCase.short_title}, currently starting at ${formatUsd(
          top.offers[0]?.price_on_demand ?? 0
        )}/hr. ${useCase.description}`
      : useCase.description,
  },
  {
    question: `How much VRAM do I need for ${useCase.short_title}?`,
    answer: `We recommend at least ${useCase.min_vram_gb}GB of VRAM for ${useCase.short_title} to avoid out-of-memory errors and support reasonable batch sizes.`,
  },
  {
    question: `Can I use a cheaper consumer GPU instead of a data-center card?`,
    answer: recommendedGpus.some((g) => g.vram_gb <= 24)
      ? `Yes — for ${useCase.short_title}, consumer cards like the RTX 4090 are often the most cost-effective choice as long as your model/batch size fits in their VRAM.`
      : `For ${useCase.short_title}, data-center cards are generally worth the premium because of higher VRAM capacity and memory bandwidth that consumer cards can't match.`,
  },
];
---

<BaseLayout meta={meta}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumbs
      crumbs={[
        { name: "Home", path: "/" },
        { name: useCase.short_title, path: `/best-gpu-for/${useCase.slug}/` },
      ]}
    />

    <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{useCase.title}</h1>
    <p class="mt-3 max-w-2xl text-slate-400">{useCase.description}</p>

    <div class="mt-4 flex flex-wrap gap-2">
      <span class="rounded-full border border-surface-600 bg-surface-800 px-3 py-1 text-xs text-slate-400">
        Recommended: {useCase.min_vram_gb}GB+ VRAM
      </span>
      {useCase.tasks.map((t) => (
        <span class="rounded-full border border-neon-blue/30 bg-neon-blue/10 px-3 py-1 text-xs text-neon-blue">{t}</span>
      ))}
    </div>

    <div class="mt-10 grid gap-6">
      {gpuOffers.map(({ gpu, offers }, index) => {
        const best = offers[0];
        return (
          <div class="card p-5">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <div class="flex items-center gap-2">
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-surface-700 text-xs font-bold text-slate-300">
                    {index + 1}
                  </span>
                  <a href={`/gpu/${gpu.id}/`} class="text-lg font-bold text-white hover:text-neon-green">
                    {gpu.name}
                  </a>
                  {index === 0 && <PriceBadge variant="best-price">Top Pick</PriceBadge>}
                </div>
                <p class="mt-2 max-w-xl text-sm text-slate-400">{gpu.description}</p>
                <p class="mt-2 text-xs text-slate-500">
                  {gpu.vram_gb}GB {gpu.vram_type} · {gpu.architecture}
                </p>
              </div>

              {best && (
                <div class="text-right">
                  <p class="font-mono text-2xl font-extrabold text-neon-green">
                    {formatUsd(best.price_on_demand)}<span class="text-sm text-slate-500">/hr</span>
                  </p>
                  <p class="text-xs text-slate-500">via {best.name}</p>
                  <CtaButton href={best.affiliate_url} class="mt-2">Rent for {formatUsd(best.price_on_demand)}/hr</CtaButton>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <section class="card mt-10 p-6">
      <h2 class="mb-2 text-xl font-bold text-white">Verdict: what should you choose for {useCase.short_title}?</h2>
      <p class="text-sm leading-relaxed text-slate-400">
        {top && (
          <>
            For most {useCase.short_title.toLowerCase()} workloads, start with the{" "}
            <strong class="text-slate-200">{top.gpu.name}</strong> — it hits the best balance of VRAM,
            throughput and price at {formatUsd(top.offers[0]?.price_on_demand ?? 0)}/hr. If your job is
            small enough to fit in less memory, downgrading to{" "}
            {gpuOffers[1] ? <strong class="text-slate-200">{gpuOffers[1].gpu.name}</strong> : "a smaller card"}{" "}
            can cut costs further without hurting throughput.
          </>
        )}
      </p>
    </section>

    <Faq faqs={faqs} title={`${useCase.short_title} FAQ`} />
  </div>
</BaseLayout>
