---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GpuFilterTable, { type GpuTableRow } from "@/components/GpuFilterTable";
import { getAllGpus, getComputedOffersForGpu } from "@/lib/data";
import { buildMeta } from "@/lib/seo";

const gpus = getAllGpus();

const rows: GpuTableRow[] = gpus
  .map((gpu) => {
    const offers = getComputedOffersForGpu(gpu.id);
    if (offers.length === 0) return null;

    const best = offers[0]; // already sorted by price_on_demand asc
    const spotOffers = offers.filter((o) => o.price_spot !== null);
    const bestSpot = spotOffers.length
      ? Math.min(...spotOffers.map((o) => o.price_spot as number))
      : null;

    const row: GpuTableRow = {
      gpuId: gpu.id,
      gpuSlug: gpu.id,
      name: gpu.name,
      vramGb: gpu.vram_gb,
      architecture: gpu.architecture,
      tasks: gpu.target_tasks,
      bestPriceOnDemand: best.price_on_demand,
      bestPriceSpot: bestSpot,
      bestProviderName: best.name,
      bestProviderUrl: best.affiliate_url,
      pricePerVramHr: best.price_per_vram_hr,
      providerCount: offers.length,
      rating: Math.max(...offers.map((o) => o.rating)),
    };
    return row;
  })
  .filter((r): r is GpuTableRow => r !== null);

const meta = buildMeta({
  title: "Compare GPU Cloud Rental Prices — H100, A100, RTX 4090 & More",
  description:
    "Live price comparison across RunPod, Vast.ai, TensorDock, Lambda Labs and CoreWeave. Filter by VRAM, task and price to find the cheapest GPU rental for LLM training, fine-tuning, ComfyUI and inference.",
  canonicalPath: "/",
});
---

<BaseLayout meta={meta}>
  <section class="mx-auto max-w-7xl px-4 pb-8 pt-14 text-center sm:px-6 lg:px-8">
    <p class="mb-3 inline-flex items-center gap-2 rounded-full border border-surface-700 bg-surface-900 px-3 py-1 text-xs font-medium text-slate-400">
      <span class="h-1.5 w-1.5 rounded-full bg-neon-green"></span>
      Tracking {rows.reduce((sum, r) => sum + r.providerCount, 0)} live offers across 5 providers
    </p>
    <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
      Find the <span class="text-gradient-neon">cheapest GPU cloud</span> for your workload
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-base text-slate-400 sm:text-lg">
      Compare on-demand and spot pricing for H100, A100, RTX 4090 and more across RunPod,
      Vast.ai, TensorDock, Lambda Labs and CoreWeave — including hidden storage and egress fees.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
    <GpuFilterTable rows={rows} client:load />
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8">
    <h2 class="mb-6 text-2xl font-bold text-white">How we calculate the best price</h2>
    <div class="grid gap-6 sm:grid-cols-3">
      <div class="card p-5">
        <h3 class="mb-2 font-semibold text-neon-green">$ / GB VRAM / hr</h3>
        <p class="text-sm text-slate-400">
          Raw hourly price is misleading across cards with different memory. We normalize every
          offer to a $/GB VRAM/hr metric so a $2.69/hr 80GB card and a $0.69/hr 24GB card can be
          compared fairly.
        </p>
      </div>
      <div class="card p-5">
        <h3 class="mb-2 font-semibold text-neon-blue">Spot vs. On-Demand</h3>
        <p class="text-sm text-slate-400">
          Spot/interruptible instances can cut costs 30-40% but may be reclaimed with little
          notice. We surface both prices side-by-side so you can pick the right tradeoff for
          fault-tolerant vs. long-running jobs.
        </p>
      </div>
      <div class="card p-5">
        <h3 class="mb-2 font-semibold text-neon-green">Hidden fees</h3>
        <p class="text-sm text-slate-400">
          Storage and egress fees vary 4x between providers and rarely show up in headline
          pricing. Every GPU detail page breaks these out so a "cheap" instance doesn't surprise
          you on the invoice.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
