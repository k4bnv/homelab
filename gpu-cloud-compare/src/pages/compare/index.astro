---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { generateGpuPairs, generateProviderPairs } from "@/utils/pseo";
import { buildMeta, SITE_NAME } from "@/lib/seo";

const gpuPairs = generateGpuPairs();
const providerPairs = generateProviderPairs();

const meta = buildMeta({
  title: "GPU & Provider Comparisons — Every Head-to-Head",
  description: `Browse every GPU-vs-GPU and provider-vs-provider comparison on ${SITE_NAME}: specs, pricing, spot rates and verdicts for renting cloud GPUs.`,
  canonicalPath: "/compare/",
});

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Compare", path: "/compare/" },
];
---

<BaseLayout meta={meta}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumbs crumbs={breadcrumbs} />

    <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
      Every GPU &amp; Provider Comparison
    </h1>
    <p class="mt-3 max-w-2xl text-slate-400">
      Head-to-head breakdowns of specs, pricing and verdicts — pick a matchup below.
    </p>

    <section class="mt-10">
      <h2 class="mb-4 text-xl font-bold text-white">GPU vs GPU ({gpuPairs.length})</h2>
      <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {gpuPairs.map((pair) => (
          <a
            href={`/compare/${pair.slug}/`}
            class="rounded-lg border border-surface-600 bg-surface-800 px-4 py-3 text-sm text-slate-300 transition hover:border-neon-green/50 hover:text-neon-green"
          >
            {pair.a.name} vs {pair.b.name}
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="mb-4 text-xl font-bold text-white">Provider vs Provider ({providerPairs.length})</h2>
      <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {providerPairs.map((pair) => (
          <a
            href={`/compare/${pair.slug}/`}
            class="rounded-lg border border-surface-600 bg-surface-800 px-4 py-3 text-sm text-slate-300 transition hover:border-neon-blue/50 hover:text-neon-blue"
          >
            {pair.a.name} vs {pair.b.name}
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
