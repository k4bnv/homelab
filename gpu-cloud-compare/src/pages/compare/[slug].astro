---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PriceBadge from "@/components/ui/PriceBadge.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import {
  getAllComparisonSlugs,
  resolveComparison,
  type AnyComparison,
} from "@/lib/comparisons";
import { getComputedOffersForGpu, getComputedOffersForProvider, formatUsd } from "@/lib/data";
import { buildMeta } from "@/lib/seo";

export function getStaticPaths() {
  return getAllComparisonSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const comparison = resolveComparison(slug as string);

if (!comparison) {
  return Astro.redirect("/404");
}

const cmp: AnyComparison = comparison;

const title =
  cmp.type === "gpu-vs-gpu"
    ? `${cmp.a.name} vs ${cmp.b.name} — Price & Specs Compared`
    : `${cmp.a.name} vs ${cmp.b.name} — Which GPU Cloud Is Cheaper?`;

const description =
  cmp.type === "gpu-vs-gpu"
    ? `${cmp.a.name} (${cmp.a.vram_gb}GB) vs ${cmp.b.name} (${cmp.b.vram_gb}GB): VRAM, architecture, price per hour and which one to pick for LLM training, fine-tuning or inference.`
    : `${cmp.a.name} vs ${cmp.b.name}: on-demand pricing, spot pricing, storage and egress fees compared side by side across shared GPUs.`;

const meta = buildMeta({
  title,
  description,
  canonicalPath: `/compare/${slug}/`,
  type: "article",
});

// --- GPU vs GPU: side-by-side specs + best offers for each ---
const gpuOffersA = cmp.type === "gpu-vs-gpu" ? getComputedOffersForGpu(cmp.a.id) : [];
const gpuOffersB = cmp.type === "gpu-vs-gpu" ? getComputedOffersForGpu(cmp.b.id) : [];

// --- Provider vs Provider: shared GPUs offered by both ---
const providerOffersA = cmp.type === "provider-vs-provider" ? getComputedOffersForProvider(cmp.a.slug) : [];
const providerOffersB = cmp.type === "provider-vs-provider" ? getComputedOffersForProvider(cmp.b.slug) : [];
const sharedGpuIds =
  cmp.type === "provider-vs-provider"
    ? providerOffersA.map((o) => o.gpu_id).filter((id) => providerOffersB.some((o) => o.gpu_id === id))
    : [];
---

<BaseLayout meta={meta}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumbs
      crumbs={[
        { name: "Home", path: "/" },
        { name: `${cmp.a.name} vs ${cmp.b.name}`, path: `/compare/${slug}/` },
      ]}
    />

    <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
      {cmp.a.name} <span class="text-slate-600">vs</span> {cmp.b.name}
    </h1>

    {cmp.type === "gpu-vs-gpu" ? (
      <>
        <p class="mt-3 max-w-2xl text-slate-400">{description}</p>

        <div class="mt-8 overflow-x-auto">
          <table class="card w-full min-w-[560px] text-left text-sm">
            <thead>
              <tr class="border-b border-surface-700 text-xs uppercase tracking-wide text-slate-500">
                <th class="px-4 py-3 font-medium">Spec</th>
                <th class="px-4 py-3 font-medium">{cmp.a.name}</th>
                <th class="px-4 py-3 font-medium">{cmp.b.name}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-800">
              <tr><td class="px-4 py-3 text-slate-500">VRAM</td><td class="px-4 py-3 font-mono">{cmp.a.vram_gb} GB {cmp.a.vram_type}</td><td class="px-4 py-3 font-mono">{cmp.b.vram_gb} GB {cmp.b.vram_type}</td></tr>
              <tr><td class="px-4 py-3 text-slate-500">Architecture</td><td class="px-4 py-3">{cmp.a.architecture}</td><td class="px-4 py-3">{cmp.b.architecture}</td></tr>
              <tr><td class="px-4 py-3 text-slate-500">FP16 TFLOPS</td><td class="px-4 py-3 font-mono">{cmp.a.fp16_tflops ?? "—"}</td><td class="px-4 py-3 font-mono">{cmp.b.fp16_tflops ?? "—"}</td></tr>
              <tr><td class="px-4 py-3 text-slate-500">Memory Bandwidth</td><td class="px-4 py-3 font-mono">{cmp.a.memory_bandwidth_gbps ?? "—"} GB/s</td><td class="px-4 py-3 font-mono">{cmp.b.memory_bandwidth_gbps ?? "—"} GB/s</td></tr>
              <tr><td class="px-4 py-3 text-slate-500">NVLink</td><td class="px-4 py-3">{cmp.a.nvlink ? "Yes" : "No"}</td><td class="px-4 py-3">{cmp.b.nvlink ? "Yes" : "No"}</td></tr>
              <tr>
                <td class="px-4 py-3 text-slate-500">Cheapest On-Demand</td>
                <td class="px-4 py-3 font-mono font-semibold text-neon-green">{gpuOffersA[0] ? formatUsd(gpuOffersA[0].price_on_demand) + "/hr" : "—"}</td>
                <td class="px-4 py-3 font-mono font-semibold text-neon-green">{gpuOffersB[0] ? formatUsd(gpuOffersB[0].price_on_demand) + "/hr" : "—"}</td>
              </tr>
              <tr>
                <td class="px-4 py-3 text-slate-500">Best For</td>
                <td class="px-4 py-3 text-xs">{cmp.a.target_tasks.join(", ")}</td>
                <td class="px-4 py-3 text-xs">{cmp.b.target_tasks.join(", ")}</td>
              </tr>
              <tr>
                <td class="px-4 py-3 text-slate-500">Rent</td>
                <td class="px-4 py-3">{gpuOffersA[0] && <CtaButton href={gpuOffersA[0].affiliate_url}>Rent {cmp.a.name}</CtaButton>}</td>
                <td class="px-4 py-3">{gpuOffersB[0] && <CtaButton href={gpuOffersB[0].affiliate_url}>Rent {cmp.b.name}</CtaButton>}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <section class="card mt-8 p-6">
          <h2 class="mb-2 text-xl font-bold text-white">Verdict: what should you choose?</h2>
          <p class="text-sm leading-relaxed text-slate-400">
            Choose the <strong class="text-slate-200">{cmp.a.name}</strong> when your job needs
            {cmp.a.vram_gb > cmp.b.vram_gb ? " more VRAM headroom or " : " "}
            {cmp.a.target_tasks[0]}. Choose the <strong class="text-slate-200">{cmp.b.name}</strong> for
            {cmp.b.target_tasks[0]}
            {cmp.b.vram_gb < cmp.a.vram_gb ? ", or when you want a lower hourly rate and don't need the extra memory." : "."}
            {gpuOffersA[0] && gpuOffersB[0] && (
              <>
                {" "}At current prices, the {cmp.a.name} starts at {formatUsd(gpuOffersA[0].price_on_demand)}/hr
                vs {formatUsd(gpuOffersB[0].price_on_demand)}/hr for the {cmp.b.name} —
                a {formatUsd(Math.abs(gpuOffersA[0].price_on_demand - gpuOffersB[0].price_on_demand))}/hr difference.
              </>
            )}
          </p>
        </section>
      </>
    ) : (
      <>
        <p class="mt-3 max-w-2xl text-slate-400">{description}</p>

        <div class="mt-8 overflow-x-auto">
          <table class="card w-full min-w-[560px] text-left text-sm">
            <thead>
              <tr class="border-b border-surface-700 text-xs uppercase tracking-wide text-slate-500">
                <th class="px-4 py-3 font-medium">Metric</th>
                <th class="px-4 py-3 font-medium">{cmp.a.name}</th>
                <th class="px-4 py-3 font-medium">{cmp.b.name}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-800">
              <tr><td class="px-4 py-3 text-slate-500">Payment Model</td><td class="px-4 py-3">{cmp.a.payment_model}</td><td class="px-4 py-3">{cmp.b.payment_model}</td></tr>
              <tr><td class="px-4 py-3 text-slate-500">Storage Cost</td><td class="px-4 py-3 font-mono">{formatUsd(cmp.a.storage_cost_per_gb, 2)}/GB/mo</td><td class="px-4 py-3 font-mono">{formatUsd(cmp.b.storage_cost_per_gb, 2)}/GB/mo</td></tr>
              <tr><td class="px-4 py-3 text-slate-500">Egress Cost</td><td class="px-4 py-3 font-mono">{cmp.a.egress_cost_per_gb === 0 ? "Free" : formatUsd(cmp.a.egress_cost_per_gb, 2) + "/GB"}</td><td class="px-4 py-3 font-mono">{cmp.b.egress_cost_per_gb === 0 ? "Free" : formatUsd(cmp.b.egress_cost_per_gb, 2) + "/GB"}</td></tr>
              <tr><td class="px-4 py-3 text-slate-500">Interruption Risk</td><td class="px-4 py-3">{cmp.a.interruption_risk}</td><td class="px-4 py-3">{cmp.b.interruption_risk}</td></tr>
              <tr><td class="px-4 py-3 text-slate-500">Rating</td><td class="px-4 py-3">★ {cmp.a.rating.toFixed(1)} ({cmp.a.review_count})</td><td class="px-4 py-3">★ {cmp.b.rating.toFixed(1)} ({cmp.b.review_count})</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mt-10">
          <h2 class="mb-4 text-xl font-bold text-white">Shared GPUs — price by card</h2>
          {sharedGpuIds.length === 0 ? (
            <p class="text-sm text-slate-500">These providers don't currently overlap on any tracked GPU.</p>
          ) : (
            <div class="card overflow-x-auto">
              <table class="w-full min-w-[560px] text-left text-sm">
                <thead>
                  <tr class="border-b border-surface-700 text-xs uppercase tracking-wide text-slate-500">
                    <th class="px-4 py-3 font-medium">GPU</th>
                    <th class="px-4 py-3 font-medium">{cmp.a.name}</th>
                    <th class="px-4 py-3 font-medium">{cmp.b.name}</th>
                    <th class="px-4 py-3 font-medium text-right">Cheaper</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-surface-800">
                  {sharedGpuIds.map((gpuId) => {
                    const offerA = providerOffersA.find((o) => o.gpu_id === gpuId)!;
                    const offerB = providerOffersB.find((o) => o.gpu_id === gpuId)!;
                    const aCheaper = offerB.price_on_demand >= offerA.price_on_demand;
                    return (
                      <tr>
                        <td class="px-4 py-3 font-semibold text-slate-100">{offerA.gpu.name}</td>
                        <td class="px-4 py-3 font-mono">
                          {formatUsd(offerA.price_on_demand)}
                          {aCheaper && <PriceBadge variant="best-price" class="ml-2" />}
                        </td>
                        <td class="px-4 py-3 font-mono">
                          {formatUsd(offerB.price_on_demand)}
                          {!aCheaper && <PriceBadge variant="best-price" class="ml-2" />}
                        </td>
                        <td class="px-4 py-3 text-right">
                          <CtaButton href={aCheaper ? offerA.affiliate_url : offerB.affiliate_url}>
                            Rent on {aCheaper ? cmp.a.name : cmp.b.name}
                          </CtaButton>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}
        </section>

        <section class="card mt-8 p-6">
          <h2 class="mb-2 text-xl font-bold text-white">Verdict: which provider should you pick?</h2>
          <p class="text-sm leading-relaxed text-slate-400">
            <strong class="text-slate-200">{cmp.a.name}</strong> runs a {cmp.a.payment_model.toLowerCase()} model
            with {cmp.a.interruption_risk.toLowerCase()} interruption risk, while
            <strong class="text-slate-200"> {cmp.b.name}</strong> is {cmp.b.payment_model.toLowerCase()} with
            {" "}{cmp.b.interruption_risk.toLowerCase()} risk. If you're running short, fault-tolerant jobs and
            want the lowest sticker price, favor whichever showed the "Best Price" badge above per GPU. For
            long-running production workloads, weigh egress fees too —
            {cmp.a.egress_cost_per_gb < cmp.b.egress_cost_per_gb ? ` ${cmp.a.name} is cheaper to move data out of.` : ` ${cmp.b.name} is cheaper to move data out of.`}
          </p>
        </section>
      </>
    )}
  </div>
</BaseLayout>
