# Copy this file to .env and fill in real values. Never commit .env.

# Telegram alert bot (create via @BotFather, get chat_id via @userinfobot or getUpdates)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTelegramBotTokenPlaceholder
TELEGRAM_CHAT_ID=123456789

# Claude API key for scraper/enrich.py (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
# Optional override, defaults to claude-sonnet-4-6 if unset
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: route requests through an HTTP(S) proxy, e.g. http://user:pass@host:port
# Leave empty to disable. See README "Как не словить бан" before enabling/disabling.
PROXY_URL=
