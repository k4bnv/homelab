# Copy to .env and adjust.

# OKX v5 API. Read-only market/public-data calls only - this bot never
# places orders. Keys are optional: public endpoints work without them,
# but authenticated requests get a higher OKX rate-limit tier.
OKX_BASE_URL=https://www.okx.com
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Comma-separated underlyings, e.g. BTC,ETH
SYMBOLS=BTC,ETH
CANDLE_BAR=15m
CANDLE_LIMIT=150
POLL_INTERVAL_SECONDS=900

# Paper-trading settings: each non-neutral signal opens a simulated $5
# position in the ATM option (real OKX bid/ask prices), closed on the
# next cycle ~15 minutes later.
STAKE_USD=5.0
STARTING_BANKROLL=1000.0
DB_PATH=./data/bets.db

# Web dashboard
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

LOG_LEVEL=INFO
