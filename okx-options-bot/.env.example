# Copy to .env and adjust.

# OKX v5 API credentials. REQUIRED to actually place orders (without them
# the bot only reads public market data and never bets). OKX_DEMO=true
# (default) makes every request carry x-simulated-trading: 1, which routes
# orders to OKX's demo/paper-trading account - use a demo API key here,
# never a live-trading key with real funds.
OKX_BASE_URL=https://www.okx.com
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEMO=true
# Trade mode for buying options. "cash" works for simple long call/put
# purchases; change only if OKX rejects orders asking for isolated/cross.
OKX_TD_MODE=cash

# Comma-separated underlyings, e.g. BTC,ETH,SOL
SYMBOLS=BTC,ETH
CANDLE_BAR=15m
CANDLE_LIMIT=150
POLL_INTERVAL_SECONDS=900

# Each non-neutral signal places a real market order (buy) on the demo
# account for ~$5 of the ATM option, closed with an offsetting sell order
# on the next cycle ~15 minutes later. Actual cost may differ from
# STAKE_USD because order size is rounded to the instrument's lot size.
STAKE_USD=5.0
STARTING_BANKROLL=1000.0
DB_PATH=./data/bets.db

# Web dashboard
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

LOG_LEVEL=INFO
