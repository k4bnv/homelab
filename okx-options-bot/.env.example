# Copy to .env and adjust.

# OKX v5 API credentials. REQUIRED - even the "public" Event Contract
# endpoints need a signed request. No trading permission needed: the bot
# never places orders (demo Event Contract order books have no liquidity -
# confirmed both via the API and manually in the app), it only reads the
# real settlement outcome to score its own predictions. OKX_DEMO=true
# (default) adds x-simulated-trading: 1 to every request - use a demo key
# here, never a live-trading key.
OKX_BASE_URL=https://www.okx.com
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEMO=true

# Comma-separated underlyings. Each one must have a matching OKX Event
# Contract series named "{SYMBOL}-UPDOWN-15MIN" - confirmed to exist for
# BTC, ETH, SOL.
SYMBOLS=BTC,ETH,SOL
CANDLE_BAR=15m
CANDLE_LIMIT=150
POLL_INTERVAL_SECONDS=900

# Signal quality/quantity knob. Score is the sum of 4 independent +-1
# factors (RSI, MACD, put/call OI ratio, 25d IV skew), so valid range is
# 1-4. 1 = every mild lean opens a trade (more, weaker signals). 4 = only
# trades when all 4 factors agree (fewer, stronger signals).
BIAS_THRESHOLD=2

# Each non-neutral signal records a paper prediction (UP/DOWN) on the
# current 15-minute Event Contract window, scored at even money
# (+STAKE_USD if the real settlement matches, -STAKE_USD if not) once OKX
# settles the contract ~15 minutes later. No real order is ever placed.
STAKE_USD=5.0
# Optional per-symbol overrides, e.g. "BTC:10,ETH:5,SOL:2" - any symbol not
# listed here falls back to STAKE_USD.
STAKE_USD_OVERRIDES=
STARTING_BANKROLL=1000.0
DB_PATH=./data/bets.db

# Web dashboard
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

LOG_LEVEL=INFO
